# FlowPilot — local development
NODE_ENV=development

# PostgreSQL (docker-compose default matches this)
DATABASE_URL="postgresql://flowpilot:flowpilot@localhost:5432/flowpilot"

# Auth.js / NextAuth (generate: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-with-a-long-random-secret-at-least-16-chars"
NEXTAUTH_URL="http://localhost:3000"

# Optional: used by clients for absolute URLs in emails/links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to 1 during local scripts if you intentionally want to bypass strict env checks
# SKIP_ENV_VALIDATION=0

# Docker multi-stage build enables Next standalone output
# DOCKER_BUILD=1
